{
  "name": "sela-cabinets",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test --grep-invert \"@auth|@a11y\"",
    "test:a11y": "playwright test --grep @a11y",
    "check:auth-coverage": "node scripts/check-api-auth-coverage.mjs",
    "test:auth": "playwright test --config=playwright.auth.config.ts --grep @auth",
    "audit:prod": "yarn audit --groups dependencies --level moderate",
    "verify": "yarn check:auth-coverage && yarn typecheck && yarn lint && yarn test --run && yarn test:e2e && yarn test:a11y && yarn test:auth && yarn build && yarn audit:prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@notionhq/client": "^2.2.15",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.39.3",
    "@types/pg": "^8.16.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.312.0",
    "next": "14.1.0",
    "openai": "^4.104.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "resend": "^3.5.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.3.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
